logging {
    channel query_log {
        file "/var/log/bind/query.log" versions 3 size 20m;
        severity info;
        print-time yes;
        print-category yes;
        print-severity yes;
    };

    channel error_log {
        file "/var/log/bind/error.log" versions 3 size 20m;
        severity warning;
        print-time yes;
        print-category yes;
        print-severity yes;
    };

    category queries   { query_log; };
    category default   { error_log; };
    category security  { error_log; };
    category config    { error_log; };
    category xfer-in   { error_log; };
    category xfer-out  { error_log; };
};
