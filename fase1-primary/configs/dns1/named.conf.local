// named.conf.local — zones del servidor primari dns1 (fase 1)
// Zona directa i inversa sense transferència (servidor únic)

zone "demobind.test" {
    type master;
    file "/etc/bind/zones/db.demobind.test";
    allow-query { any; };
};

zone "50.25.10.in-addr.arpa" {
    type master;
    file "/etc/bind/zones/db.10.25.50";
    allow-query { any; };
};
