; db.demobind.test — Zona directa de demobind.test
; Fase 3: Amb delegació del subdomini magatzem.demobind.test

$TTL 86400
@   IN  SOA dns1.demobind.test. hostmaster.demobind.test. (
        2026052803  ; serial
        3600        ; refresh  (1 hora)
        900         ; retry    (15 minuts)
        604800      ; expire   (1 setmana)
        86400 )     ; negative TTL (1 dia)

; Servidors de noms del domini principal
@       IN  NS      dns1.demobind.test.
@       IN  NS      dns2.demobind.test.

; Registres MX (correu)
@       IN  MX  10  mail.demobind.test.

; Hosts del domini principal
dns1            IN  A       10.25.50.11
dns2            IN  A       10.25.50.12
mail            IN  A       10.25.50.50
www             IN  A       10.25.50.80
cl01            IN  A       10.25.50.101
cl02            IN  A       10.25.50.102

; Glue records — adreces dels servidors de noms del subdomini delegat
; Necessaris per trencar la dependència circular de resolució
dns3            IN  A       10.25.50.21
dns4            IN  A       10.25.50.22

; Delegació del subdomini magatzem.demobind.test
; Els registres NS apunten als servidors autoritatius del subdomini
magatzem        IN  NS      dns3.demobind.test.
magatzem        IN  NS      dns4.demobind.test.
